# Copia este archivo como .env en el VPS y completa los valores. NUNCA subas .env a GitHub.

# Dominio del juego (registro A apuntando a la IP del VPS)
DOMINIO=horizonte.tudominio.pe

# Debe coincidir con tu Traefik (ver deploy/VPS.md para sacar estos valores)
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# Clave de https://api.nasa.gov (queda solo en el servidor)
NASA_API_KEY=pega_aqui_tu_clave

# Clave del panel docente (genera una con: openssl rand -hex 24)
DOCENTE_TOKEN=cambia_esto_por_una_clave_larga
